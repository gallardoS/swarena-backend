# Reference values. Set them in IntelliJ's Run Configuration or in the deployment environment.
# Never commit real credentials.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/acore_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=swarena_backend
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-password

SWARENA_REGISTRATION_ENABLED=true
SWARENA_REGISTRATION_EXPANSION=2

# Cloudflare Turnstile. Keep the real secret only in .env or deployment variables.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
